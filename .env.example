# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# Anything prefixed with NEXT_PUBLIC_ is inlined into the client bundle and is
# public forever. No secrets there, ever.

# --- Public values (safe to expose) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_IMAGE_BASE_URL=https://img.fototecalapelada.com.ar

# --- Database: Neon Postgres (server only) ---
# Use Neon's POOLED connection string, the host with `-pooler` in it. The client
# runs with prepare:false because PgBouncer in transaction mode cannot hold
# prepared statements, and max:1 because a serverless instance needs no pool.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- Auth.js v5 with Google (server only) ---
# Generate the secret with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=000000000000-example.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=example-not-a-real-google-client-secret
# The site's own origin, no path. Auth.js refuses to trust the Host header
# unless it recognises the platform, so it needs this anywhere that is not
# Vercel and not `next dev` -- `npm run start` on your machine, above all.
# On Vercel it is detected and this stays unset.
AUTH_URL=http://localhost:3000

# --- Cloudflare R2: web derivatives (server only) ---
R2_ACCOUNT_ID=example-account-id
R2_ACCESS_KEY_ID=example-access-key-id
R2_SECRET_ACCESS_KEY=example-not-a-real-secret-access-key
R2_BUCKET=fototeca-la-pelada

# --- Google Drive: preservation masters (server only) ---
# base64 of the service account JSON key. The JSON file never enters the repo.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=eyJleGFtcGxlIjogIm5vdC1yZWFsIn0=
GOOGLE_DRIVE_MASTERS_FOLDER_ID=example-drive-folder-id
